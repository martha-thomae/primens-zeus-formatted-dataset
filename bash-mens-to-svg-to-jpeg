for f in ./*/*/*/*.mns; do
    out="SVG/${f#./}"
    out="${out%.mns}.svg"

    mkdir -p "$(dirname "$out")"

    verovio "$f" --breaks none -o "$out"
done

for f in ./SVG/*/*/*/*.svg; do
    out="JPEG/${f#./SVG/}"
    out="${out%.svg}.jpg"

    mkdir -p "$(dirname "$out")"

    magick -background white -density 300 "$f" \
        -alpha remove -alpha off \
        -gravity north -chop 0x100 \
        -gravity south -chop 0x350 \
        "$out"
done
